{
  "name": "vramfit",
  "version": "0.2.0",
  "description": "Will this model run on my machine, and how fast? VRAM, KV-cache and throughput arithmetic for local LLM inference.",
  "keywords": [
    "llm",
    "vram",
    "kv-cache",
    "quantization",
    "gguf",
    "safetensors",
    "huggingface",
    "moe",
    "llama.cpp",
    "gpu",
    "capacity-planning"
  ],
  "license": "Apache-2.0",
  "author": "Johan Becker <jo_becker@mailbox.org> (https://github.com/johan-becker)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vramfit": "dist/bin/vramfit.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "oxlint --deny-warnings src test scripts",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johan-becker/vramfit.git"
  },
  "bugs": {
    "url": "https://github.com/johan-becker/vramfit/issues"
  },
  "homepage": "https://github.com/johan-becker/vramfit#readme"
}
